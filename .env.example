# Contoh file environment untuk Theodore Coffee.
# Cara pakai: salin file ini menjadi .env.local, lalu isi nilainya.
# .env.local tidak ikut masuk git (sudah diatur di .gitignore).

# URL project Supabase, contoh: https://abcdefghijkl.supabase.co
# Boleh dibaca di browser, jadi variabelnya memakai awalan NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=

# Kunci publik (anon) Supabase.
# Dipakai di browser untuk akses data yang sudah dibatasi oleh RLS,
# jadi kunci ini relatif aman untuk ditaruh di kode klien.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kunci service role Supabase. INI RAHASIA.
# Hanya boleh dipakai di sisi server (src/server), misalnya untuk menulis log.
# JANGAN dipakai di komponen browser dan JANGAN di-commit ke git.
SUPABASE_SERVICE_ROLE_KEY=
